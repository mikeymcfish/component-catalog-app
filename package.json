{
  "name": "component-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first web application for cataloging electronic components, storage cases, datasheets, photos, and 3D models.",
  "type": "module",
  "license": "0BSD",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeymcfish/component-catalog-app.git"
  },
  "bugs": {
    "url": "https://github.com/mikeymcfish/component-catalog-app/issues"
  },
  "homepage": "https://github.com/mikeymcfish/component-catalog-app#readme",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node scripts/start-production.mjs",
    "test": "node --import tsx scripts/verify-port-fallback.ts && node --import tsx scripts/verify-lan-access.ts && node --import tsx scripts/verify-storage-process-lock.ts && node --import tsx scripts/verify-model-viewer-wrapper.ts && node --import tsx scripts/verify-app.ts && node --import tsx scripts/verify-case-3d-geometry.ts && node --import tsx scripts/verify-phone-component-finder.ts",
    "test:lan-launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-lan-launch.ps1",
    "test:phone": "node --import tsx scripts/verify-phone-component-finder.ts",
    "test:3d": "node --import tsx scripts/verify-case-3d-geometry.ts",
    "check": "tsc && tsc -p tsconfig.verify.json",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@hookform/resolvers": "^5.5.7",
