# Copy this file to .env.phone.local after completing the README setup.
# Never commit .env.phone.local.
PHONE_ACCESS_ENABLED=true
PHONE_ACCESS_HOST=127.0.0.1
PHONE_ACCESS_PORT=5002

# Your assigned ngrok HTTPS dev domain, without a trailing slash.
MCP_PUBLIC_URL=https://YOUR-ASSIGNED-DOMAIN.ngrok-free.app

# Auth0 tenant issuer. Keep the trailing slash.
AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/

# Create an Auth0 API with this identifier. It should match the protected MCP resource.
AUTH0_AUDIENCE=https://YOUR-ASSIGNED-DOMAIN.ngrok-free.app/mcp
AUTH0_SCOPE=inventory:read
